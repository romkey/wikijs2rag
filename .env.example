# ── Wiki.js connection ─────────────────────────────────────────────────────────
# Base URL of your Wiki.js instance (no trailing slash).
WIKI_URL=https://wiki.example.com

# Optional: Wiki.js API key.
# Create one at /a/api-keys in the admin panel (read-only scope is enough).
# Leave empty if your wiki allows unauthenticated GraphQL access.
WIKI_API_KEY=

# ── Qdrant ─────────────────────────────────────────────────────────────────────
# These default to the values shown when running under docker compose.
# Override only if you point to an external Qdrant instance.
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333

# Name of the Qdrant collection to write to.
# Use different collection names to keep multiple wikis separate.
QDRANT_COLLECTION=wiki

# Host ports exposed by docker compose (optional overrides).
# QDRANT_REST_PORT=6333
# QDRANT_GRPC_PORT=6334

# ── Embeddings (OpenAI-compatible API) ───────────────────────────────────────
# Base URL of an OpenAI-compatible API (the part before /embeddings).
# Defaults to OpenAI.  Any compatible server works, e.g.:
#   Ollama (in Docker):  http://host.docker.internal:11434/v1
#   vLLM / LM Studio / LiteLLM: http://<host>:<port>/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: API key, sent as "Authorization: Bearer <key>".
# Required for OpenAI; leave empty for local servers that don't need one.
OPENAI_API_KEY=

# Embedding model name.
# OpenAI choices:
#   text-embedding-3-small – 1536-dim, cheap and good  (default)
#   text-embedding-3-large – 3072-dim, highest quality
# With Ollama, use a pulled model such as nomic-embed-text.
EMBEDDING_MODEL=text-embedding-3-small

# Optional: request shorter vectors (text-embedding-3-* only).
# EMBEDDING_DIMENSIONS=

# Max token context length for the embedding model.
# Texts longer than this are truncated before embedding.
# Default 8191 matches OpenAI's embedding models; check your model's docs.
EMBEDDING_CONTEXT_LENGTH=8191

# ── Chunking ───────────────────────────────────────────────────────────────────
# Maximum words per chunk.
CHUNK_SIZE=256

# Words of overlap between consecutive chunks.
CHUNK_OVERLAP=50

# Parent chunk ratio: every N consecutive chunks share the same parent_chunk_index.
PARENT_CHUNK_RATIO=4

# ── Ingestion behaviour ───────────────────────────────────────────────────────
# Seconds between ingestion runs.  Default 3600 (1 hour).
# Set to 0 for one-shot mode (run once and exit).
POLL_INTERVAL_SECONDS=3600

# Set to true to re-ingest all pages even if updatedAt hasn't changed.
FORCE_REINGEST=false

# ── Performance ────────────────────────────────────────────────────────────────
# Number of chunks sent to the embeddings API in a single call.
EMBEDDING_BATCH_SIZE=32

# Seconds to wait between page fetches (avoid hammering the wiki).
PAGE_DELAY_SECONDS=0.1

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
