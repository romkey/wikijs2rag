# Every environment variable this project uses, with dummy values. Copy to
# .env (gitignored) and fill in real values there; never in this file.
# docs/configuration.md says what each one does.

# --- Wiki.js -----------------------------------------------------------------

# Base URL of your Wiki.js instance. Required.
WIKI_URL=https://wiki.example.com

# API key, only if the wiki restricts guest access to the GraphQL endpoint.
# Create one under Administration -> API Access (read access to pages).
# WIKI_API_KEY=REPLACE_ME

# --- Qdrant ------------------------------------------------------------------

# The compose files set QDRANT_HOST=qdrant. Natively, the ingester defaults
# to "qdrant" and the query tool to "localhost".
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333

# Collection to write to and search. Use one per wiki.
QDRANT_COLLECTION=wiki

# Host ports compose publishes Qdrant on (not read by the app).
# QDRANT_REST_PORT=6333
# QDRANT_GRPC_PORT=6334

# --- Embeddings (OpenAI-compatible API) -------------------------------------

# Compose runs Hugging Face Text Embeddings Inference (TEI) as the "tei"
# service when this profile is on. Remove it to use another embeddings server.
COMPOSE_PROFILES=tei

# TEI image. The default is x86-64; on ARM (Apple Silicon, Graviton) use
# ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9.4, and on NVIDIA
# GPUs one of TEI's GPU images. TEI_PORT is the host port it's published on.
# TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9.4
# TEI_PORT=8080

# Longest input TEI embeds, in tokens; longer ones are truncated. Its memory
# use grows with the square of this: about 1.5 GB at 2048, 3 GB at 4096 and
# over 8 GB at 8192. Keep EMBEDDING_CONTEXT_LENGTH no larger.
# TEI_MAX_BATCH_TOKENS=2048

# Base URL of an OpenAI-compatible API (the part before /embeddings).
# Compose defaults it to the tei service, http://tei/v1; run natively, the
# default is http://localhost:8080/v1 (TEI on its host port). Other servers:
#   OpenAI:                       https://api.openai.com/v1
#   TEI or vLLM elsewhere:        http://<host>:<port>/v1
# OPENAI_BASE_URL=http://tei/v1

# Bearer token. Required for OpenAI; leave unset for TEI and other servers
# without auth.
# OPENAI_API_KEY=REPLACE_ME

# Embedding model: a Hugging Face model id for TEI (compose starts TEI with
# it), or an OpenAI model name. Changing it changes the vectors: use a new
# QDRANT_COLLECTION and FORCE_REINGEST=true.
EMBEDDING_MODEL=nomic-ai/modernbert-embed-base

# Prefixes ("prompts") put in front of every query and every document before
# embedding. Leave them unset to use the model's own, for the models below
# (matched by name); set them for any other model that needs them. Use "none"
# for no prefix, \n for a newline; a space is added if the prefix doesn't end
# in one. Changing the document prefix needs FORCE_REINGEST=true, and RAG apps
# that query Qdrant must embed their queries with the same query prefix.
#
#   Model                                      Query prefix / document prefix
#   nomic-ai/modernbert-embed-base (default)   "search_query: " / "search_document: "
#     768-dim, 8192-token context
#   nomic-ai/nomic-embed-text-v1.5             "search_query: " / "search_document: "
#     768-dim, 8192-token context
#   intfloat/e5-large-v2                       "query: " / "passage: "
#     1024-dim, 512-token context (also intfloat/multilingual-e5-large)
#   mixedbread-ai/mxbai-embed-large-v1         "Represent this sentence for searching relevant passages: " / none
#     1024-dim, 512-token context
#   Qwen/Qwen3-Embedding-0.6B                  "Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery:" / none
#     1024-dim, 32768-token context (set EMBEDDING_CONTEXT_LENGTH to what you serve)
#   OpenAI text-embedding-3-small / -large     none / none
#     1536 / 3072-dim, 8191-token context
# EMBEDDING_QUERY_PREFIX="search_query: "
# EMBEDDING_DOCUMENT_PREFIX="search_document: "

# Shorter vectors, for models that accept the "dimensions" parameter (OpenAI
# text-embedding-3-*). Unset for the model's full size.
# EMBEDDING_DIMENSIONS=512

# Context length in tokens; longer texts are truncated. Match it to the model
# (see above), and with TEI to TEI_MAX_BATCH_TOKENS if that's lower:
# ModernBERT Embed takes 8192, but TEI here defaults to 2048. 512 for e5 and mxbai.
EMBEDDING_CONTEXT_LENGTH=2048

# Chunks per embeddings request.
EMBEDDING_BATCH_SIZE=32

# --- Chunking ----------------------------------------------------------------

# Maximum words per chunk, and words shared between consecutive chunks.
CHUNK_SIZE=256
CHUNK_OVERLAP=50

# Every N consecutive chunks share a parent_chunk_index.
PARENT_CHUNK_RATIO=4

# --- Ingestion ---------------------------------------------------------------

# Seconds between runs; 0 runs once and exits.
POLL_INTERVAL_SECONDS=3600

# true re-ingests every page, even if its updatedAt hasn't changed.
FORCE_REINGEST=false

# Seconds to pause between pages, to go easy on the wiki.
PAGE_DELAY_SECONDS=0.1

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# --- Query tool (wikijs2rag-query); flags override these ---------------------

# QUERY_LIMIT=5
# QUERY_SHOW_TEXT=false
# QUERY_MIN_SCORE=0.0
# QUERY_WIDTH=100
# Any value turns off colored output (https://no-color.org/).
# NO_COLOR=1

# --- Docker compose (not read by the app) ------------------------------------

# Release tag of the image docker-compose.prod.yaml runs; default latest.
# APP_VERSION=1.2.3
